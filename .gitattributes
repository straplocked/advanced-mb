# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.h text
*.cpp text
*.cmake text
*.md text
*.yml text
*.yaml text
*.txt text
*.json text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.vst3 binary
*.component binary
*.app binary
